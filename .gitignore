# This is a .gitignore file for Unity projects
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/

# MemoryCaptures can get large and are usually specific to individual machines
/[Mm]emoryCaptures/

# Visual Studio cache directory
.vs/

# Visual Studio Code cache directory
.vscode/

# Unity generated local metadata
/*.csproj
/*.sln
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.opendb
/*.VC.db

# Autogenerated JetBrains Rider plugin
.idea/

# macOS
.DS_Storefirebase_credenciales.json 
